# Gere o .env com scripts/criar-env.sh (cria a senha do banco). O .env nunca vai para o Git.

APP_ENV=dev
TIMEZONE=America/Sao_Paulo

# Banco. O docker compose monta DATABASE_URL a partir destes valores.
POSTGRES_DB=financas
POSTGRES_USER=financas
POSTGRES_PASSWORD=troque-esta-senha

# Bot do Telegram (etapa 3)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=100000001,100000002

# Gemini (etapa 3)
GEMINI_API_KEY=
GEMINI_MODEL=

# Página web e Cloudflare Access (etapa 5)
ACCESS_ALLOWED_EMAILS=ana@example.com,bruno@example.com
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
# Só em APP_ENV=dev: simula o usuário logado sem o Cloudflare Access.
DEV_USER_EMAIL=ana@example.com
